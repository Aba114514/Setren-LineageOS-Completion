<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_performance"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="preload_face"
            android:summary="@string/preload_face_summary"
            android:title="@string/preload_face_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="early_unlock_hook"
            android:summary="@string/early_unlock_summary"
            android:title="@string/early_unlock_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_security"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="require_pin_on_boot"
            android:summary="@string/require_pin_summary"
            android:title="@string/require_pin_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="bypass_keyguard"
            android:summary="@string/bypass_keyguard_summary"
            android:title="@string/bypass_keyguard_title"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="mode_unlock_fading"
            android:dependency="bypass_keyguard"
            android:entries="@array/unlock_animation"
            android:entryValues="@array/unlock_animation_values"
            android:key="unlock_animation"
            android:title="@string/unlock_animation_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_feedback"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="show_status_text"
            android:summary="@string/show_status_summary"
            android:title="@string/show_status_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
