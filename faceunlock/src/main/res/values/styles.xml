<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppBaseTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="AppTheme" parent="@style/AppBaseTheme" />

    <style name="AppTheme.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="SettingsTheme" parent="@style/AppTheme" />

    <style name="ShapeAppearanceOverlay.UniversalAuth.Hero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.UniversalAuth.Section" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="SuwGlifButton.Primary" parent="Widget.Material3Expressive.Button">
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="SuwGlifButton.Secondary" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="ButtonText" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ButtonTextRound" parent="Widget.Material3Expressive.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">2</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="InfoTextFinished" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_marginStart">@dimen/settings_tutorial_side_margin</item>
        <item name="android:layout_marginEnd">@dimen/settings_tutorial_side_margin</item>
    </style>
</resources>
