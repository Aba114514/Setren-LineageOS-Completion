<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="72dp" android:paddingStart="8dp" android:paddingEnd="8dp"
        app:title="@string/lineage_title" app:subtitle="@string/lineage_subtitle" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="12dp" android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.UniversalAuth.Section">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/feature_recents" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/lineage_recents" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    <TextView android:id="@+id/summary_recents" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/lineage_recents_summary"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.UniversalAuth.Section">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/feature_face" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/lineage_face" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    <TextView android:id="@+id/summary_face" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/lineage_face_summary"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/face_settings" style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/lineage_face_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.UniversalAuth.Section">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/feature_brightness" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/lineage_brightness" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    <TextView android:id="@+id/summary_brightness" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/lineage_brightness_summary"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.UniversalAuth.Section">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/feature_aod" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/lineage_aod" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/lineage_aod_summary"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aod_duration" style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/lineage_aod" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aod_system_settings" style="@style/Widget.Material3Expressive.Button.TextButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/lineage_aod_system_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.UniversalAuth.Section">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/hide_launcher_icon" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/lineage_hide_icon" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/lineage_hide_icon_summary"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/module_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:text="@string/lineage_setup" android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
