<?xml version="1.0" encoding="utf-8"?>
<!-- Modified for LineageEnhance integration; see NOTICE. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ax.nd.faceunlock">

    <uses-permission android:name="android.permission.CAMERA" />

    <permission
        android:name="com.setren.lineageenhance.permission.UNLOCK_DEVICE"
        android:description="@string/unlock_device_permission_desc"
        android:label="@string/unlock_device_permission_label"
        android:protectionLevel="dangerous" />

    <application
        android:name=".FaceApplication"
        android:allowBackup="false"
        android:icon="@drawable/setren_avatar"
        android:roundIcon="@drawable/setren_avatar"
        android:label="@string/lineage_title"
        android:resizeableActivity="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="最近任务锁定、人脸解锁、限时息屏显示与亮屏修复" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".FaceAuthActivity"
            android:showOnLockScreen="true"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity android:name="com.setren.lineageenhance.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="${applicationId}.Launcher"
            android:targetActivity="com.setren.lineageenhance.SettingsActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".SetupFaceIntroActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/title_activity_face_intro"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme" />
        <activity
            android:name=".FaceEnrollActivity"
            android:excludeFromRecents="true"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme" />
        <activity
            android:name=".FaceFinish"
            android:excludeFromRecents="true"
            android:label="@string/facelock_setup_notification_text"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme" />
        <activity
            android:name=".FaceTryAgain"
            android:excludeFromRecents="true"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme" />
        <activity
            android:name=".FaceValuePropActivity"
            android:excludeFromRecents="true"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme" />
        <activity
            android:name=".FaceUpgradeFinish"
            android:excludeFromRecents="true"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme" />

        <service
            android:name=".service.FaceAuthService"
            android:exported="false"
            android:label="@string/lineage_title" />

        <service android:name=".service.LockscreenFaceAuthService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>
    </application>
</manifest>
